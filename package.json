{
  "name": "maidong",
  "version": "1.0.0",
  "description": "麦冬云诊所 - 专业的中医诊所管理系统",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "麦冬科技",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.7",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.maidong.app",
    "productName": "Maidong",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**"
    ],
    "icon": "assets/icon.png",
    "publish": [
      {
        "provider": "github"
      }
    ],
    "mac": {
      "target": ["dmg"]
    },
    "win": {
      "target": ["nsis"]
    }
  }
}
