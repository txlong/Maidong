{
  "name": "maidong-app",
  "version": "1.0.0",
  "description": "麦冬云诊所 - 专业的中医诊所管理系统",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.7"
  },
  "build": {
    "appId": "com.maidong.app",
    "productName": "麦冬云诊所",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "mac": {
      "target": ["dmg"]
    },
    "win": {
      "target": ["nsis"]
    }
  }
}
